#Postgres (used by the db container and by the app)
POSTGRES_DB=stealthpay
POSTGRES_USER=stealthpay
POSTGRES_PASSWORD=

# Sepolia
SEPOLIA_RPC_URL=

# Scanner: viewing private key v and spending public key K (hex)
STEALTHPAY_VIEWING_PRIVATE_KEY=
STEALTHPAY_SPENDING_PUBLIC_KEY=
STEALTHPAY_SCAN_START_BLOCK=
STEALTHPAY_CONFIRMATIONS=12
# Lower this if your RPC provider limits the eth_getLogs block range (some free tiers allow only 10)
STEALTHPAY_MAX_BLOCKS_PER_BATCH=500

# Demo sender wallet (Sepolia faucet funds)
STEALTHPAY_SENDER_PRIVATE_KEY=

# Spending private key k: only needed for sweeping
STEALTHPAY_SPENDING_PRIVATE_KEY=
